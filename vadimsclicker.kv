#:kivy 2.3.1

<ClickerSettings@TriggerSettings>:

    height: '58dp'

    text: 'Clicker Settings'
    
    TriggerInput:
        trigger: root.trigger
        #current_trigger: self.trigger.hotkey


<HolderSettings@TriggerSettings>:

    height: '58dp'

    text: 'Holder Settings'
    
    TriggerInput:
        trigger: root.trigger
        #current_trigger: trigger.hotkey


<TopLayout>:
    
    font_size: '20dp'
    label_size: '40dp'
    spacing: '9dp'
    inner_spacing: '15dp'
    text: 'Vadim Clicker'
    
    ClickerSettings:
        trigger: root.triggers[0] if root.triggers else None
    HolderSettings:
        trigger: root.triggers[1] if root.triggers else None
